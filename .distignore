# .distignore - Files to exclude from WordPress.org SVN deployment

# ===================
# Version Control
# ===================
/.git
/.gitignore
/.gitattributes
/.distignore

# ===================
# GitHub/CI
# ===================
/.github

# ===================
# Node/NPM
# ===================
/node_modules
package.json
package-lock.json
/.npm
/.npmrc

# ===================
# Source Files
# ===================
/src
/assets-src

# ===================
# Build Tools
# ===================
webpack.config.js
tsconfig.json
lint-staged.config.js
jest.config.js
/scripts
/tools
/.nvmrc

# ===================
# Testing
# ===================
/tests
/playwright-report
/test-results
/.playwright
playwright.config.js
phpunit.xml
phpunit.xml.dist
/.phpunit.result.cache

# ===================
# WordPress Dev Environment
# ===================
/.wp-env*.json
/wordpress

# ===================
# Claude AI
# ===================
/.claude
/.agents
/.codex
/.Codex
/.superpowers
/.coderabbit.yaml

# ===================
# Documentation
# ===================
/docs
*.md
!readme.txt

# ===================
# Composer
# ===================
composer.json
composer.lock
/vendor

# ===================
# Linting/Formatting
# ===================
.eslintrc*
.eslintignore
.stylelintrc*
.prettierrc*
.prettierignore
.editorconfig
phpcs.xml
phpcs.xml.dist
phpstan.neon
phpstan-constants.php
psalm.xml

# ===================
# IDE/Editor
# ===================
/.vscode
/.idea
*.sublime-project
*.sublime-workspace

# ===================
# OS Files
# ===================
.DS_Store
Thumbs.db
*.swp
*.swo

# ===================
# Temporary/Cache
# ===================
/tmp
/temp
/.cache
*.log
npm-debug.log*

# ===================
# Backups
# ===================
*.backup
*.bak
*.sql
*.db
*.js.backup
*.php.backup

# ===================
# Git Hooks
# ===================
/.husky

# ===================
# Build/Deployment Artifacts
# ===================
/bin
/deployment-package
/*.zip

# ===================
# Environment
# ===================
.env
.env.*

# ===================
# Marketing Assets (deployed separately to SVN assets)
# ===================
/.wordpress-org
/images
/assets/banner-*
/assets/icon-*
/assets/screenshot-*
# Keep assets/images/patterns/ because registered patterns use these URLs.

# ===================
# Translation Sources
# ===================
languages/*.po
languages/*.pot

# ===================
# Source Maps (never ship to production)
# ===================
*.js.map
*.css.map
