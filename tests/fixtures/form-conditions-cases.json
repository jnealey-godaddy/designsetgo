{
	"$comment": "Shared by tests/unit/form-conditions.test.js and tests/phpunit/form-conditions-test.php. Each case runs through both evaluators; expectedVisible lists visible field names in document order.",
	"cases": [
		{ "description": "no conditions: all visible", "fields": [ "a", "b" ], "conditions": {}, "values": {}, "expectedVisible": [ "a", "b" ] },
		{ "description": "is: case and whitespace insensitive", "fields": [ "type", "company" ], "conditions": { "company": { "operator": "AND", "rules": [ { "field": "type", "op": "is", "value": " Business " } ] } }, "values": { "type": "business" }, "expectedVisible": [ "type", "company" ] },
		{ "description": "is: no match hides", "fields": [ "type", "company" ], "conditions": { "company": { "rules": [ { "field": "type", "op": "is", "value": "Business" } ] } }, "values": { "type": "Personal" }, "expectedVisible": [ "type" ] },
		{ "description": "is with empty value equals empty", "fields": [ "a", "b" ], "conditions": { "b": { "rules": [ { "field": "a", "op": "is", "value": "" } ] } }, "values": { "a": "  " }, "expectedVisible": [ "a", "b" ] },
		{ "description": "is_not", "fields": [ "a", "b" ], "conditions": { "b": { "rules": [ { "field": "a", "op": "is_not", "value": "x" } ] } }, "values": { "a": "X" }, "expectedVisible": [ "a" ] },
		{ "description": "contains: case-insensitive substring", "fields": [ "a", "b" ], "conditions": { "b": { "rules": [ { "field": "a", "op": "contains", "value": "ÉCOLE" } ] } }, "values": { "a": "la grande école" }, "expectedVisible": [ "a", "b" ] },
		{ "description": "contains: empty needle never matches", "fields": [ "a", "b" ], "conditions": { "b": { "rules": [ { "field": "a", "op": "contains", "value": "" } ] } }, "values": { "a": "anything" }, "expectedVisible": [ "a" ] },
		{ "description": "empty: unchecked checkbox (absent value)", "fields": [ "agree", "why" ], "conditions": { "why": { "rules": [ { "field": "agree", "op": "empty", "value": "" } ] } }, "values": {}, "expectedVisible": [ "agree", "why" ] },
		{ "description": "not_empty: checked checkbox", "fields": [ "agree", "extra" ], "conditions": { "extra": { "rules": [ { "field": "agree", "op": "not_empty", "value": "" } ] } }, "values": { "agree": "1" }, "expectedVisible": [ "agree", "extra" ] },
		{ "description": "gt numeric", "fields": [ "qty", "bulk" ], "conditions": { "bulk": { "rules": [ { "field": "qty", "op": "gt", "value": "10" } ] } }, "values": { "qty": "10.5" }, "expectedVisible": [ "qty", "bulk" ] },
		{ "description": "lt numeric negative", "fields": [ "n", "m" ], "conditions": { "m": { "rules": [ { "field": "n", "op": "lt", "value": "-1" } ] } }, "values": { "n": "-2" }, "expectedVisible": [ "n", "m" ] },
		{ "description": "gt dates compare as strings", "fields": [ "d", "late" ], "conditions": { "late": { "rules": [ { "field": "d", "op": "gt", "value": "2026-01-31" } ] } }, "values": { "d": "2026-02-01" }, "expectedVisible": [ "d", "late" ] },
		{ "description": "lt time with and without seconds", "fields": [ "t", "early" ], "conditions": { "early": { "rules": [ { "field": "t", "op": "lt", "value": "09:00:30" } ] } }, "values": { "t": "09:00" }, "expectedVisible": [ "t", "early" ] },
		{ "description": "gt non-comparable is false", "fields": [ "a", "b" ], "conditions": { "b": { "rules": [ { "field": "a", "op": "gt", "value": "5" } ] } }, "values": { "a": "five" }, "expectedVisible": [ "a" ] },
		{ "description": "gt empty actual is false", "fields": [ "a", "b" ], "conditions": { "b": { "rules": [ { "field": "a", "op": "gt", "value": "0" } ] } }, "values": {}, "expectedVisible": [ "a" ] },
		{ "description": "AND requires all", "fields": [ "a", "b", "c" ], "conditions": { "c": { "operator": "AND", "rules": [ { "field": "a", "op": "is", "value": "1" }, { "field": "b", "op": "is", "value": "1" } ] } }, "values": { "a": "1", "b": "0" }, "expectedVisible": [ "a", "b" ] },
		{ "description": "OR requires any (lower-case operator accepted)", "fields": [ "a", "b", "c" ], "conditions": { "c": { "operator": "or", "rules": [ { "field": "a", "op": "is", "value": "1" }, { "field": "b", "op": "is", "value": "1" } ] } }, "values": { "a": "1", "b": "0" }, "expectedVisible": [ "a", "b", "c" ] },
		{ "description": "chain: hidden source reads as empty", "fields": [ "a", "b", "c" ], "conditions": { "b": { "rules": [ { "field": "a", "op": "is", "value": "yes" } ] }, "c": { "rules": [ { "field": "b", "op": "not_empty", "value": "" } ] } }, "values": { "a": "no", "b": "typed earlier" }, "expectedVisible": [ "a" ] },
		{ "description": "chain declared out of order resolves", "fields": [ "c", "b", "a" ], "conditions": { "c": { "rules": [ { "field": "b", "op": "not_empty", "value": "" } ] }, "b": { "rules": [ { "field": "a", "op": "is", "value": "yes" } ] } }, "values": { "a": "no", "b": "x", "c": "" }, "expectedVisible": [ "a" ] },
		{ "description": "two-field loop terminates deterministically", "fields": [ "a", "b" ], "conditions": { "a": { "rules": [ { "field": "b", "op": "empty", "value": "" } ] }, "b": { "rules": [ { "field": "a", "op": "empty", "value": "" } ] } }, "values": { "a": "x", "b": "y" }, "expectedVisible": [ "b" ] },
		{ "description": "self-reference ignored", "fields": [ "a" ], "conditions": { "a": { "rules": [ { "field": "a", "op": "is", "value": "zzz" } ] } }, "values": { "a": "x" }, "expectedVisible": [ "a" ] },
		{ "description": "unknown source ignored", "fields": [ "a", "b" ], "conditions": { "b": { "rules": [ { "field": "deleted_field", "op": "is", "value": "x" } ] } }, "values": {}, "expectedVisible": [ "a", "b" ] },
		{ "description": "invalid op ignored", "fields": [ "a", "b" ], "conditions": { "b": { "rules": [ { "field": "a", "op": "matches", "value": "x" } ] } }, "values": { "a": "y" }, "expectedVisible": [ "a", "b" ] },
		{ "description": "one valid rule among ignored ones still applies", "fields": [ "a", "b" ], "conditions": { "b": { "rules": [ { "field": "", "op": "is", "value": "x" }, { "field": "a", "op": "is", "value": "show" } ] } }, "values": { "a": "hide" }, "expectedVisible": [ "a" ] },
		{ "description": "non-string values: number and array", "fields": [ "n", "arr", "x", "y" ], "conditions": { "x": { "rules": [ { "field": "n", "op": "is", "value": "3" } ] }, "y": { "rules": [ { "field": "arr", "op": "empty", "value": "" } ] } }, "values": { "n": 3, "arr": [ "a" ] }, "expectedVisible": [ "n", "arr", "x", "y" ] },
		{ "description": "null and malformed conditions mean visible", "fields": [ "a", "b", "c" ], "conditions": { "b": null, "c": { "operator": "AND", "rules": "nope" } }, "values": {}, "expectedVisible": [ "a", "b", "c" ] }
	]
}
