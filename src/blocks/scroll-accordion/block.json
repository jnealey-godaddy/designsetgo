{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "designsetgo/scroll-accordion",
	"version": "1.0.0",
	"title": "Scroll Accordion",
	"category": "designsetgo",
	"description": "Accordion that reveals items progressively as you scroll down the page",
	"keywords": [
		"scroll",
		"accordion",
		"sticky",
		"stacking"
	],
	"textdomain": "designsetgo",
	"icon": "menu-alt2",
	"attributes": {
		"align": {
			"type": "string"
		},
		"textAlign": {
			"type": "string"
		},
		"alignItems": {
			"type": "string",
			"default": "flex-start"
		}
	},
	"supports": {
		"anchor": true,
		"align": [
			"wide",
			"full"
		],
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"layout": {
			"allowEditing": false
		}
	},
	"example": {
		"innerBlocks": [
			{
				"name": "designsetgo/scroll-accordion-item",
				"attributes": {
					"style": {
						"color": {
							"background": "#1e293b",
							"text": "#ffffff"
						}
					}
				},
				"innerBlocks": [
					{
						"name": "core/heading",
						"attributes": {
							"level": 3,
							"content": "First card"
						}
					},
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Cards stack on top of each other as the page scrolls."
						}
					}
				]
			},
			{
				"name": "designsetgo/scroll-accordion-item",
				"attributes": {
					"style": {
						"color": {
							"background": "#334155",
							"text": "#ffffff"
						}
					}
				},
				"innerBlocks": [
					{
						"name": "core/heading",
						"attributes": {
							"level": 3,
							"content": "Second card"
						}
					},
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Each card sticks until the next one covers it."
						}
					}
				]
			}
		]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
