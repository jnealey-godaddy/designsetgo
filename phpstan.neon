parameters:
	# Level 5 provides strong type checking without being overly strict
	level: 5

	# Paths to analyze
	paths:
		- includes
		- designsetgo.php

	# Excluded paths
	excludePaths:
		- vendor
		- node_modules
		- build
		- tests
		- .wp-env
		- includes/blocks/query/class-query-filter-index-cli.php
		# Query Monitor integration: optional dependency, runtime-guarded with class_exists().
		# QM stubs aren't available, so analysing extends \QM_Collector / \QM_Output_Html fails.
		- includes/integrations/query-monitor/class-query-qm-collector.php
		- includes/integrations/query-monitor/class-query-qm-output.php

	# Bootstrap files for WordPress functions and plugin constants
	bootstrapFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
		- designsetgo.php
		- phpstan-constants.php

	ignoreErrors:
		# WordPress globals
		- '#Undefined variable: \$wpdb#'
		- '#Undefined variable: \$wp_#'

		# WordPress functions that PHPStan doesn't understand
		- '#Function wp_[a-z_]+ not found#'
		- '#Function get_[a-z_]+ not found#'
		- '#Function add_[a-z_]+ not found#'
		- '#Function register_[a-z_]+ not found#'

		# WP_CLI class is excluded from analysis; suppress the call-site reference in class-plugin.php
		- '#Call to static method register\(\) on an unknown class DesignSetGo\\Blocks\\Query\\FilterIndexCLI#'

		# Allow dynamic properties (common in WordPress)
		- '#Access to an undefined property#'

		# Ignore missing array typehints (common in WordPress)
		-
			identifier: missingType.iterableValue

		# Ignore missing generic typehints (common in WordPress)
		-
			identifier: missingType.generics

	# Report unmatched ignored errors
	reportUnmatchedIgnoredErrors: false
