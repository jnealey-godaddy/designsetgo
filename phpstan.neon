parameters:
	# Level 5 provides strong type checking without being overly strict
	level: 5

	# Paths to analyze
	paths:
		- includes
		- designsetgo.php

	# Excluded paths
	excludePaths:
		- vendor
		- node_modules
		- build
		- tests
		- .wp-env
		- includes/blocks/query/class-query-filter-index-cli.php
		# Query Monitor integration: optional dependency, runtime-guarded with class_exists().
		# QM stubs aren't available, so analysing extends \QM_Collector / \QM_Output_Html fails.
		- includes/integrations/query-monitor/class-query-qm-collector.php
		- includes/integrations/query-monitor/class-query-qm-output.php

	# Bootstrap files for WordPress functions and plugin constants
	bootstrapFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
		- designsetgo.php
		- phpstan-constants.php

	# WooCommerce stubs let us analyse the Woo integration surface (bindings sources,
	# product-aware query args, cart blocks) instead of excluding it the way the
	# Query Monitor integration above is excluded for lack of stubs. Every Woo call
	# site is still runtime-guarded — the stubs are a static-analysis aid only.
	#
	# scanFiles, not bootstrapFiles: PHPStan *executes* bootstrap files, and the Woo
	# stubs define thousands of classes, which pushes the analysis past a 1G memory
	# limit. scanFiles registers the symbols without executing them.
	scanFiles:
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php

	ignoreErrors:
		# WordPress globals
		- '#Undefined variable: \$wpdb#'
		- '#Undefined variable: \$wp_#'

		# WordPress functions that PHPStan doesn't understand
		- '#Function wp_[a-z_]+ not found#'
		- '#Function get_[a-z_]+ not found#'
		- '#Function add_[a-z_]+ not found#'
		- '#Function register_[a-z_]+ not found#'

		# WP_CLI class is excluded from analysis; suppress the call-site reference in class-plugin.php
		- '#Call to static method register\(\) on an unknown class DesignSetGo\\Blocks\\Query\\FilterIndexCLI#'

		# Allow dynamic properties (common in WordPress)
		- '#Access to an undefined property#'

		# wp_style_engine_get_styles() only sets 'css' when a style group actually has
		# declarations, then array_filter()s the result (wp-includes/style-engine.php).
		# So 'css' is genuinely absent for any group with no styles — the common case.
		# The wordpress-stubs signature wrongly types it as always-present, which makes
		# PHPStan call our (necessary) isset() redundant. The guard stays; the stub is wrong.
		# count pins this to the two style-engine 'css' guards it is justified for,
		# so the other isset() calls in the file stay analysed.
		-
			identifier: isset.offset
			path: includes/block-support-routing.php
			count: 2

		# Ignore missing array typehints (common in WordPress)
		-
			identifier: missingType.iterableValue

		# Ignore missing generic typehints (common in WordPress)
		-
			identifier: missingType.generics

	# Report unmatched ignored errors
	reportUnmatchedIgnoredErrors: false
