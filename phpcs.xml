<?xml version="1.0"?>
<ruleset name="DesignSetGo">
	<description>DesignSetGo WordPress Coding Standards</description>

	<!-- Files to check -->
	<file>./designsetgo.php</file>
	<file>./includes</file>

	<!-- Exclude patterns -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<!-- Arguments -->
	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>

	<!-- Rules -->
	<rule ref="WordPress-Core">
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<rule ref="WordPress-Docs"/>

	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<!-- WordPress VIP platform coding standards -->
	<rule ref="WordPressVIPMinimum">
		<!-- Valid on activation/deactivation for rewrite rule cleanup -->
		<exclude name="WordPressVIPMinimum.Functions.RestrictedFunctions.flush_rewrite_rules_flush_rewrite_rules"/>
		<!-- HTTP_USER_AGENT read only in POST REST/ajax handlers; not subject to page caching -->
		<exclude name="WordPressVIPMinimum.Variables.RestrictedVariables.cache_constraints___SERVER__HTTP_USER_AGENT__"/>
		<!-- REMOTE_ADDR used only for server-side rate limiting; no viable client-side alternative -->
		<exclude name="WordPressVIPMinimum.Variables.RestrictedVariables.cache_constraints___SERVER__REMOTE_ADDR__"/>
		<!-- wp_mail is used for single transactional form emails, not bulk mail -->
		<exclude name="WordPressVIPMinimum.Functions.RestrictedFunctions.wp_mail_wp_mail"/>
		<!-- setcookie() used only in admin-facing draft-mode toggle endpoint; not subject to page caching -->
		<exclude name="WordPressVIPMinimum.Functions.RestrictedFunctions.cookies_setcookie"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="designsetgo"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.Security"/>

	<rule ref="WordPress.WhiteSpace.ControlStructureSpacing">
		<properties>
			<property name="blank_line_check" value="true"/>
		</properties>
	</rule>

	<!-- Allow slash-separated hook names for namespacing -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<!-- Allow error_log() when wrapped in WP_DEBUG check -->
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude name="WordPress.PHP.DevelopmentFunctions.error_log_error_log"/>
	</rule>

	<!-- Allow file_get_contents for local files only -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<properties>
			<property name="exclude" value="file_get_contents"/>
		</properties>
	</rule>

	<!-- Variables starting with _ are intentionally unused ($_ prefix convention) -->
	<rule ref="VariableAnalysis.CodeAnalysis.VariableAnalysis">
		<properties>
			<property name="ignoreUnusedRegexp" value="/^_/"/>
		</properties>
	</rule>

	<!-- Minimum PHP version -->
	<config name="minimum_supported_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
