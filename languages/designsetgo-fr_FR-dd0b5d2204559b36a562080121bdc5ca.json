{"translation-revision-date":"2026-09-14 00:00+0000","generator":"WP-CLI\/2.12.0","source":"src\/extensions\/interactions\/components\/InteractionModal.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"fr_FR","plural-forms":"nplurals=2; plural=(n > 1);"},"Key":[""],"That is not a valid CSS selector.":[""],"No elements on this page match.":[""],"Matches %d element.":[""],"Pick a target":[""],"Click any block in the editor to target it. Blocks without an anchor or class will be given one automatically.":[""],"Cancel (Esc)":[""],"Edit interaction":[""],"When":[""],"For example: Escape, Enter, a. Leave empty for any key.":[""],"Affect":[""],"CSS selector":[""],"Pick on canvas":[""],"That block cannot be given a CSS class, so it cannot be targeted automatically. Give it an HTML anchor under Advanced, then enter #your-anchor here.":[""],"Do":[""],"Attribute name":[""],"For example: aria-expanded. Event handlers are not allowed.":[""],"Offset (px)":[""],"Stop this far above the target \u2014 useful to clear a sticky header.":[""],"Only once":[""],"Run the first time it is triggered, then never again.":[""],"For this to reveal anything, the target must start hidden. Add the class %s to it under Advanced \u2192 Additional CSS class(es).":[""],"Blocks that are not already buttons or links will be given keyboard and screen-reader button semantics automatically.":[""],"Done":[""]}}}