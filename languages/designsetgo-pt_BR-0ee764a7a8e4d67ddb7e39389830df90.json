{"translation-revision-date":"2026-09-14 00:00+0000","generator":"WP-CLI\/2.12.0","source":"src\/overlay-header\/index.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"pt_BR","plural-forms":"nplurals=2; plural=(n > 1);"},"Header Display":[""],"Overlay Header":[""],"Makes the header transparent and positions it over the page content. Best used with hero sections that have a background image or color.":[""],"Skip Top Bar":[""],"Only overlay the main header row. If your header has a top bar, the hero content will begin below it.":[""],"Overlay Text Color":[""],"Sets the header text color while the header is transparent. The scroll text color is controlled in the Sticky Header settings.":[""],"Preview this page on the frontend to see the overlay effect.":[""]}}}