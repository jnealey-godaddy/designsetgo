.":[""],"40% means the logo is scaled to 60% of its original size.":[""],"White":[""],"Black":[""],"Gray":[""],"Blue":[""],"Dark":[""],"Dark Gray":[""],"Change text color when scrolled. Useful for transparent headers with light text over hero images.":[""]}}}