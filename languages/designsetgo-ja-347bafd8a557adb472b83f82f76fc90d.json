{"translation-revision-date":"2026-09-14 00:00+0000","generator":"WP-CLI\/2.12.0","source":"build\/ext-sticky-header.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ja","plural-forms":"nplurals=1; plural=0;"},"Sticky Header":[""],"Enable Sticky Header":[""],"Shadow Size":["\u77e2\u5370\u30b5\u30a4\u30ba"],"Small":[""],"Medium":["\u30e1\u30c7\u30a3\u30a2"],"Large":["\u30ea\u30f3\u30af\u30bf\u30fc\u30b2\u30c3\u30c8"],"Shrink Amount (%)":[""],"None":["\u306a\u3057"],"Sticky header is disabled in DesignSetGo Settings. Enable it in Settings > DesignSetGo to use these controls.":[""],"Configure sticky header behavior for this template part.":[""],"Make this header stick to the top when scrolling.":[""],"Shadow depth when scrolled.":[""],"Hide on Scroll Down":["\u30b9\u30af\u30ed\u30fc\u30eb\u3067\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3"],"Auto-hide when scrolling down, show when scrolling up.":[""],"Background on Scroll":["\u80cc\u666f\u8272"],"Use global background color setting when scrolled.":["\u80cc\u666f\u8272\u306f\u4e0b\u306e\u300c\u30ab\u30e9\u30fc\u300d\u30d1\u30cd\u30eb\u3067\u8a2d\u5b9a\u3055\u308c\u307e\u3059\u3002"],"Additional settings like z-index, transition speed, and background color can be configured in DesignSetGo Settings.":[""],"Shrink Logo on Scroll":[""],"Scale down images (site logo, image blocks) inside the header when scrolled. Keeps aspect ratio \u2014 works for wide or tall logos.":[""],"How much to shrink the logo. 40% means scaled to 60% of original size.":[""],"Skip Top Bar on Scroll":[""],"If your header has a top bar (e.g. social links), it scrolls away before the nav sticks.":[""]}}}